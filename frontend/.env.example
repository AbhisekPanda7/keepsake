# Copy to .env.local for development, or set in Vercel's project settings.

# Where the Keepsake backend runs. With it set, people sign in and their albums are kept
# in their account (database and photo storage on the server). Leave it empty and albums
# stay in each browser, with no accounts.
#   Deployed:          https://<your-backend>.onrender.com
#   Local backend:     http://localhost:8081   (cd backend, then mvnw spring-boot:test-run)
NEXT_PUBLIC_API_URL=
