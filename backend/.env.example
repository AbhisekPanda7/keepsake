# Copy the names into Render's environment settings, or set them locally.
# Never commit real values. This file only documents what's needed.

# --- Required ------------------------------------------------------------------

# Supabase: Project Settings > Database > Connection string > Session pooler, as JDBC.
# Render can't reach Supabase's direct connection, which is IPv6 only on the free plan.
DATABASE_URL=jdbc:postgresql://aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres.YOUR-PROJECT-REF
DATABASE_PASSWORD=

# Signs login tokens. At least 32 characters; the app won't start otherwise.
# Generate one with: openssl rand -base64 48
JWT_SECRET=

# Your Vercel site. Comma-separated if there's more than one.
CORS_ALLOWED_ORIGINS=https://your-site.vercel.app

# Must be "supabase" on Render: its free plan's disk is wiped on every restart.
STORAGE_TYPE=supabase
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Project Settings > API Keys > Secret keys (sb_secret_...). The legacy service_role key
# (eyJ...) also works until Supabase retires it. Either has full access to the project:
# server only, never in a browser.
SUPABASE_SERVICE_KEY=
# Create this bucket in Supabase, and keep it private.
SUPABASE_BUCKET=photos

# --- Password reset emails -------------------------------------------------------

# The website that reset links open (your Vercel site), with no trailing slash.
APP_URL=https://your-site.vercel.app
# "brevo" sends real email through Brevo's API. "none" (the default) sends nothing, and
# forgotten-password requests then quietly do nothing. "outbox" writes each email to a file
# in MAIL_OUTBOX_DIR: for your own computer only, never a server.
# Brevo, not SMTP, because Render's free plan blocks outgoing SMTP ports.
MAIL_TYPE=none
# The sender address. With Brevo's free plan, verify it first under Senders.
MAIL_FROM=
MAIL_FROM_NAME=Keepsake
# Brevo > SMTP & API > API keys. It can send email as you: server only, never in a browser.
BREVO_API_KEY=

# --- Optional ------------------------------------------------------------------

# How long a reset link works, in minutes (5 to 120).
RESET_TOKEN_TTL_MINUTES=30

# How long a sign-in lasts.
JWT_TTL_HOURS=168
# Storage allowed per account. 209715200 is 200 MB.
QUOTA_BYTES_PER_USER=209715200
DATABASE_POOL_SIZE=5
