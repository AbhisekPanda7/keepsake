# Copy the names into Render's environment settings, or set them locally.
# Never commit real values. This file only documents what's needed.

# --- Required ------------------------------------------------------------------

# Supabase: Project Settings > Database > Connection string > Session pooler, as JDBC.
# Render can't reach Supabase's direct connection, which is IPv6 only on the free plan.
DATABASE_URL=jdbc:postgresql://aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres.YOUR-PROJECT-REF
DATABASE_PASSWORD=

# Signs login tokens. At least 32 characters; the app won't start otherwise.
# Generate one with: openssl rand -base64 48
JWT_SECRET=

# Your Vercel site. Comma-separated if there's more than one.
CORS_ALLOWED_ORIGINS=https://your-site.vercel.app

# Must be "supabase" on Render: its free plan's disk is wiped on every restart.
STORAGE_TYPE=supabase
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Project Settings > API. It has full access to the project: server only, never in a browser.
SUPABASE_SERVICE_KEY=
# Create this bucket in Supabase, and keep it private.
SUPABASE_BUCKET=photos

# --- Optional ------------------------------------------------------------------

# How long a sign-in lasts.
JWT_TTL_HOURS=168
# Storage allowed per account. 209715200 is 200 MB.
QUOTA_BYTES_PER_USER=209715200
DATABASE_POOL_SIZE=5
